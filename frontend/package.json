{
  "name": "dispatch-twin-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "models:build": "node tools/blender/run-blender.mjs tools/blender/build_equipment.py -- tools/blender/out",
    "models:check": "node tools/blender/run-blender.mjs tools/blender/check_items.py -- --render",
    "models:optimize": "node tools/blender/optimize.mjs",
    "models": "npm run models:build && npm run models:check && npm run models:optimize"
  },
  "dependencies": {
    "@react-three/drei": "^9.120.4",
    "@react-three/fiber": "^8.17.12",
    "mp4-muxer": "^5.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
